# 一時ファイル
tmp/

# 大容量の ArduPilot ログは Git に直接入れず、Markdown から保存先を参照する。
*.BIN
*.bin
*.ulg
*.tlog

# 各プロジェクトの採用ログだけは Git LFS で管理する。
!projects/**/logs/accepted/
!projects/**/logs/accepted/**

# ローカル環境の不要ファイル
.DS_Store
Thumbs.db
.vscode/

# ローカルAIエージェント用の指示・設定
/AGENTS.md
/.agents/
/.codex/

# 公式サイトからダウンロードした参考資料本体はGit管理しない。
# 資料一覧MarkdownだけをGit管理する。
/参考資料/Pixhawk6Cmini_Holybro/**/*
!/参考資料/Pixhawk6Cmini_Holybro/**/
!/参考資料/Pixhawk6Cmini_Holybro/保存資料一覧.md
/参考資料/Pixhawk2.4.8Pro_RCToySky/**/*
!/参考資料/Pixhawk2.4.8Pro_RCToySky/**/
!/参考資料/Pixhawk2.4.8Pro_RCToySky/保存資料一覧.md
/参考資料/TF-luna/**/*
!/参考資料/TF-luna/**/
!/参考資料/TF-luna/保存資料一覧.md
/参考資料/ISDT_608PD/**/*
!/参考資料/ISDT_608PD/**/
!/参考資料/ISDT_608PD/保存資料一覧.md
