# Accepted raw rover logs are stored with Git LFS.
logs/accepted/*.bin filter=lfs diff=lfs merge=lfs -text
logs/accepted/*.BIN filter=lfs diff=lfs merge=lfs -text
logs/accepted/*.ulg filter=lfs diff=lfs merge=lfs -text
logs/accepted/*.tlog filter=lfs diff=lfs merge=lfs -text

# Allow one level of date or test-name subdirectories under logs/accepted.
logs/accepted/**/*.bin filter=lfs diff=lfs merge=lfs -text
logs/accepted/**/*.BIN filter=lfs diff=lfs merge=lfs -text
logs/accepted/**/*.ulg filter=lfs diff=lfs merge=lfs -text
logs/accepted/**/*.tlog filter=lfs diff=lfs merge=lfs -text
